# Copia este archivo como .env solo en tu equipo. No subas .env al repositorio.
# En Railway crea estas mismas variables en la pestaña Variables.

# Gmail requiere una contrasena de aplicacion, no la contrasena normal de la cuenta.
# Esto solo funciona en local: Railway bloquea las conexiones SMTP salientes
# (puerto 465/587), asi que en produccion hay que usar Brevo (ver abajo).
FIMACOR_SMTP_USER=noreply.fimacor.sistema@gmail.com
FIMACOR_SMTP_PASSWORD=PEGA_AQUI_LA_CONTRASENA_DE_APLICACION

# En Railway el correo se envia por la API HTTP de Brevo (brevo.com, tiene plan
# gratis), no por SMTP directo. Sin BREVO_API_KEY el codigo cae a Gmail SMTP y
# el envio se cuelga con SocketTimeoutException. El remitente debe estar
# verificado en Brevo (single sender o dominio) o el envio falla igual.
BREVO_API_KEY=PEGA_AQUI_LA_API_KEY_DE_BREVO
BREVO_SENDER_EMAIL=noreply.fimacor.sistema@gmail.com
BREVO_SENDER_NAME=FIMACOR | SENA

# Reubicaciones usa las mismas credenciales por defecto. Define estas si quieres otra cuenta.
FIMACOR_REUBICACION_SMTP_USER=noreply.fimacor.sistema@gmail.com
FIMACOR_REUBICACION_SMTP_PASSWORD=PEGA_AQUI_LA_CONTRASENA_DE_APLICACION

# URL publica real de Railway para enlaces de correo, QR e imagenes publicas.
FIMACOR_PUBLIC_BASE_URL=https://tu-dominio.up.railway.app
RAILWAY_PUBLIC_DOMAIN=tu-dominio.up.railway.app

# Base de datos Railway/MySQL.
FIMACOR_DB_HOST=host.mysql.railway.internal
FIMACOR_DB_PORT=3306
FIMACOR_DB_NAME=FIMACOR
FIMACOR_DB_USER=root
FIMACOR_DB_PASSWORD=PEGA_AQUI_LA_CLAVE_DE_MYSQL
FIMACOR_DB_URL=jdbc:mysql://host.mysql.railway.internal:3306/FIMACOR?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota